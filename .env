# =========================
# DATABASE
# =========================
POSTGRES_DB=production_manager
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/production_manager
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_DB_PASSWORD

# =========================
# FLYWAY
# =========================
FLYWAY_URL=jdbc:postgresql://postgres:5432/production_manager
FLYWAY_USER=postgres
FLYWAY_PASSWORD=CHANGE_ME_DB_PASSWORD

# =========================
# REDIS
# =========================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# =========================
# AWS S3 (IAM USER)
# =========================
AWS_S3_ACCESS_KEY=CHANGE_ME_S3_ACCESS_KEY
AWS_S3_SECRET_KEY=CHANGE_ME_S3_SECRET_KEY
AWS_S3_REGION=ap-southeast-1
AWS_S3_BUCKET=planning-prod-files

# =========================
# AWS SES (IAM USER)
# =========================
AWS_SES_ACCESS_KEY=CHANGE_ME_SES_ACCESS_KEY
AWS_SES_SECRET_KEY=CHANGE_ME_SES_SECRET_KEY
AWS_SES_REGION=ap-southeast-1
SES_FROM_EMAIL=no-reply@yourdomain.com

# =========================
# PUBLIC DOMAIN (for email links)
# =========================
PUBLIC_BASE_URL=https://planning.yourdomain.com
